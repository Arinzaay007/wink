# ── Wink environment ────────────────────────────────────────────────
# Copy to .env and fill in.

# Neon Postgres connection string (free tier: neon.tech)
# Required for username claims, ledger, dashboards.
DATABASE_URL=

# Session signing secret — any long random string for dev
SESSION_SECRET=dev-wink-secret-change-me

# Tempo network: "testnet" (Moderato) or "mainnet"
TEMPO_NETWORK=testnet

# (Optional) Tempo API Console key for indexer/webhooks — api.tempo.xyz
TEMPO_API_KEY=

# (Optional) Platform fee-payer private key for gas sponsorship (testnet only!)
TEMPO_SPONSOR_KEY=

# ── Email (Resend) ──────────────────────────────────────────────────
# Resend API key for OTP + payment notifications (noreply@winkpay.xyz)
RESEND_API_KEY=
WINK_MAIL_FROM=Wink <noreply@winkpay.xyz>

# Public URL of the app (used for email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Auto-forwarder (mainnet) ────────────────────────────────────────
# Burner wallet that is watched on Base/Eth/Arb/Op/Poly → Tempo pathUSD
BURNER_PRIVATE_KEY=
FORWARDER_TEMPO_RECEIVER=
# Sponsor wallet that pays gas for gasless forwards (Option A self-sustaining)
# Keeps friendly fee 1% min $0.01 max $0.10 as USDC on Base to refill ETH
SPONSOR_PRIVATE_KEY=
SPONSOR_ADDRESS=
